---
import Logo from '../ui/Logo.astro';
import Bouton from '../ui/Bouton.astro';
import { contact, ctaFinal } from '../../content/textes';
---

<section class="cta fond-nuit fond-sombre motif-hex" aria-labelledby="cta-titre" data-cta>
  <svg class="cta__reseau" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <g class="cta__liens" stroke="#D9B24A" stroke-width="1.5" stroke-linecap="round">
      <path d="M120 120 600 300M180 500 600 300M1080 110 600 300M1040 520 600 300M380 60 600 300M820 560 600 300M40 330 600 300M1160 340 600 300" pathLength="1" />
    </g>
    <g class="cta__noeuds" fill="#D9B24A">
      <circle cx="120" cy="120" r="6" /><circle cx="180" cy="500" r="5" /><circle cx="1080" cy="110" r="6" /><circle cx="1040" cy="520" r="5" />
      <circle cx="380" cy="60" r="4" /><circle cx="820" cy="560" r="4" /><circle cx="40" cy="330" r="4" /><circle cx="1160" cy="340" r="4" />
    </g>
  </svg>
  <div class="conteneur cta__contenu">
    <Logo variante="logo_vertical" couleur="couleur" class="cta__logo" />
    <h2 id="cta-titre" class="titre-2 text-or">{ctaFinal.titre}</h2>
    <p class="text-lg">{ctaFinal.texte}</p>
    <Bouton href={contact.whatsapp} icone="whatsapp" taille="grand" externe>{ctaFinal.bouton}</Bouton>
    <a class="cta__tel lien-souligne" href={`tel:${contact.telephoneInternational}`}>{contact.telephoneAffiche}</a>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    padding: clamp(5rem, 14vw, 10rem) 0;
    text-align: center;
  }
  .cta__reseau {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.2;
  }
  .cta__liens path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .cta__contenu {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.5rem;
  }
  .cta__contenu :global(.cta__logo) {
    width: 220px;
    height: auto;
    margin-bottom: 1rem;
  }
  .cta__tel {
    font: 600 1.25rem/1 var(--font-titre);
    letter-spacing: 0.04em;
    color: var(--or-pale);
  }
</style>

---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { realisations } from '../../content/textes';

// Les images avant / après sont lues dans assets/avant-apres/.
// Tant que avant.png n'est pas fourni, une case « à fournir » s'affiche.
const images = import.meta.glob<{ default: ImageMetadata }>('/assets/avant-apres/*.{png,jpg,jpeg,webp}', { eager: true });
const trouver = (nom: string) =>
  Object.entries(images).find(([chemin]) => chemin.split('/').pop()?.startsWith(nom))?.[1].default;
const avant = trouver('avant');
const apres = trouver('apres');
---

<section id="realisations" class="realisations fond-ivoire" aria-labelledby="realisations-titre">
  <div class="conteneur">
    <div class="realisations__entete" data-revele>
      <p class="surtitre text-petrole">{realisations.surtitre}</p>
      <h2 id="realisations-titre" class="titre-2 text-petrole mt-3">{realisations.titre}</h2>
    </div>

    <figure class="cas" data-hex-revele>
      <div class="comparateur" data-comparateur style="--position: 50%">
        <div class="comparateur__vue comparateur__vue--avant">
          {avant ? (
            <Picture src={avant} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 960px) 800px, 100vw" alt="Ancien logo de BIDOSS PARAISO" loading="lazy" class="comparateur__img" />
          ) : (
            <p class="comparateur__manquant">{realisations.avantManquant}</p>
          )}
          <span class="comparateur__etiquette comparateur__etiquette--avant">{realisations.avant}</span>
        </div>
        <div class="comparateur__vue comparateur__vue--apres" data-comparateur-apres>
          {apres && (
            <Picture src={apres} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 960px) 800px, 100vw" alt="Nouveau logo de BIDOSS PARAISO" loading="lazy" class="comparateur__img" />
          )}
          <span class="comparateur__etiquette comparateur__etiquette--apres">{realisations.apres}</span>
        </div>
        <span class="comparateur__poignee" aria-hidden="true"><span></span></span>
        <input
          class="comparateur__curseur"
          type="range"
          min="0"
          max="100"
          value="50"
          step="1"
          aria-label={realisations.curseurLibelle}
          aria-valuetext="50 % de l'ancien logo visible"
          data-comparateur-curseur
        />
      </div>
      <figcaption class="cas__legende">
        <strong class="font-titre text-petrole text-lg">{realisations.casTitre}</strong>
        <span class="comparateur__aide">{realisations.casTexte}</span>
      </figcaption>
    </figure>

    <ul class="clients">
      {realisations.clients.map((c, i) => (
        <li class="client" style={`--i:${i}`} data-hex-revele>
          <span class="client__forme" aria-hidden="true"></span>
          <p class="client__texte">{c}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .realisations {
    padding: clamp(5rem, 12vw, 9rem) 0;
  }
  .realisations__entete {
    margin-bottom: 2.5rem;
  }
  .cas {
    max-width: 50rem;
  }
  .comparateur {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--rayon);
    overflow: hidden;
    background: var(--petrole);
    touch-action: pan-y;
  }
  .comparateur__vue {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .comparateur__vue--avant {
    background: color-mix(in srgb, var(--ardoise) 8%, var(--ivoire));
  }
  .comparateur__vue--apres {
    background: var(--petrole);
    clip-path: inset(0 0 0 var(--position));
  }
  .comparateur__vue :global(picture) {
    display: contents;
  }
  .comparateur__vue :global(.comparateur__img) {
    width: 60%;
    height: 62%;
    object-fit: contain;
  }
  .comparateur__manquant {
    position: absolute;
    left: 0;
    width: 50%;
    padding: 0 1rem;
    text-align: center;
    font: 600 1.125rem/1.3 var(--font-titre);
    color: var(--ardoise);
  }
  .comparateur__etiquette {
    position: absolute;
    top: 16px;
    padding: 6px 12px;
    border-radius: 999px;
    font: 600 0.8125rem/1 var(--font-texte);
  }
  .comparateur__etiquette--avant {
    left: 16px;
    background: var(--ardoise);
    color: var(--ivoire);
  }
  .comparateur__etiquette--apres {
    right: 16px;
    background: var(--or);
    color: var(--nuit);
  }
  .comparateur__poignee {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--position);
    width: 2px;
    margin-left: -1px;
    background: var(--or);
    pointer-events: none;
  }
  .comparateur__poignee span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 50px;
    translate: -50% -50%;
    background: var(--or);
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
  }
  .comparateur__poignee span::after {
    content: "‹ ›";
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font: 600 1rem/1 var(--font-texte);
    color: var(--nuit);
  }
  /* Le vrai contrôle : un curseur natif (souris, tactile, clavier) invisible par-dessus */
  .comparateur__curseur {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .comparateur:has(.comparateur__curseur:focus-visible) {
    outline: 3px solid var(--petrole);
    outline-offset: 4px;
  }
  .cas__legende {
    display: grid;
    gap: 4px;
    margin-top: 1rem;
  }
  .clients {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(3rem, 8vw, 5rem);
  }
  @media (min-width: 768px) {
    .clients {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .client {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border-radius: var(--rayon);
    border: 2px dashed color-mix(in srgb, var(--petrole) 45%, transparent);
    text-align: center;
    padding: 1.5rem;
  }
  .client__forme {
    position: absolute;
    width: 72px;
    aspect-ratio: 100 / 115.47;
    top: 50%;
    left: 50%;
    translate: -50% -80%;
    background: color-mix(in srgb, var(--petrole) 12%, transparent);
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
  }
  .client__texte {
    position: relative;
    margin-top: 4.5rem;
    font-weight: 600;
    color: var(--ardoise);
  }
</style>

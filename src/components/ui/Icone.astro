---
/**
 * Icônes de la charte : grille 24 px, trait 2 px, bouts arrondis.
 * Chaque tracé porte pathLength="1" pour l'animation « trait qui se dessine ».
 */
const icones = {
  logo: '<path d="M12 2.5 20.2 7.25v9.5L12 21.5l-8.2-4.75v-9.5Z"/><path d="M12 12V7.5M12 12l-3.9 2.25M12 12l3.9 2.25"/><circle cx="12" cy="12" r="1.2"/>',
  site: '<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 8h18M7 6h.01M10 6h.01M8 22h8M12 18v4"/>',
  google: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.5"/>',
  reseaux: '<path d="M4 5h11a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H9l-4 3v-3H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z"/><path d="M17 9h3a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-1v3l-4-3h-2"/>',
  confiance: '<path d="M12 2.5 19.5 5.5v6c0 4.6-3.2 8.3-7.5 10-4.3-1.7-7.5-5.4-7.5-10v-6Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
  proximite: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><path d="M9.5 10.5h5M12 8v5"/>',
  rapidite: '<circle cx="12" cy="13" r="8"/><path d="M12 13V9M12 13l3 2M10 2h4"/>',
  rigueur: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/>',
  whatsapp: '<path d="M4.5 19.5 5.8 15.6A8 8 0 1 1 8.6 18.4Z"/><path d="M9.2 9.2c0 2.9 2.7 5.6 5.6 5.6l1-1.4-2-1-1 .8a4 4 0 0 1-2-2l.8-1-1-2Z"/>',
  fleche: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  bas: '<path d="M12 5v14M6 13l6 6 6-6"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  recherche: '<circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/>',
  coeur: '<path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10Z"/>',
  etoile: '<path d="m12 3 2.7 5.6 6.1.8-4.4 4.3 1 6.1L12 16.9l-5.4 2.9 1-6.1-4.4-4.3 6.1-.8Z"/>',
} as const;

export type NomIcone = keyof typeof icones;

interface Props {
  nom: NomIcone;
  class?: string;
  taille?: number;
}
const { nom, class: classe = '', taille = 24 } = Astro.props;
const contenu = icones[nom].replace(/<(path|rect|circle)/g, '<$1 pathLength="1"');
---

<svg
  class={`icone ${classe}`}
  width={taille}
  height={taille}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={contenu}
/>
